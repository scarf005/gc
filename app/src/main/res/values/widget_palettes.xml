    <array name="widget_palette_halloween_light">
        <item>#eff2f5</item>
        <item>#f0db3d</item>
        <item>#ffd642</item>
        <item>#f68c41</item>
        <item>#1f2328</item>
    </array>
    <array name="widget_palette_halloween_dark">

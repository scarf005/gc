    </array>
    <color name="widget_border_dark_high_contrast">#ffffff</color>
    <array name="widget_palette_dark_dimmed">
        <item>#2a313c</item>
        <item>#1b4721</item>
        <item>#2b6a30</item>
        <item>#46954a</item>

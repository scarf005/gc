<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="WidgetTheme">
        <attr name="widgetThemeKey" format="string" />
        <attr name="widgetThemeTitle" format="reference" />
        <attr name="widgetThemeBackground" format="reference" />
        <attr name="widgetThemePalette" format="reference" />
        <attr name="widgetThemeBorder" format="color" />
        <attr name="widgetThemeAliases" format="reference" />
    </declare-styleable>

    <string name="widget_theme_default_key" translatable="false">light</string>
    <array name="widget_themes">
        <item>@style/WidgetTheme.Light</item>
        <item>@style/WidgetTheme.Dark</item>
        <item>@style/WidgetTheme.LightHighContrast</item>
        <item>@style/WidgetTheme.DarkHighContrast</item>
        <item>@style/WidgetTheme.DarkDimmed</item>
        <item>@style/WidgetTheme.DarkDimmedHighContrast</item>
        <item>@style/WidgetTheme.HalloweenLight</item>
        <item>@style/WidgetTheme.HalloweenDark</item>
        <item>@style/WidgetTheme.WinterLight</item>
        <item>@style/WidgetTheme.WinterDark</item>
        <item>@style/WidgetTheme.Transparent</item>
    </array>

    <style name="WidgetTheme.Light" parent="">
        <item name="widgetThemeKey">light</item>
        <item name="widgetThemeTitle">@string/widget_theme_light</item>
        <item name="widgetThemeBackground">@drawable/widget_background</item>
        <item name="widgetThemePalette">@array/widget_palette_light</item>
    </style>
    <style name="WidgetTheme.Dark" parent="">
        <item name="widgetThemeKey">dark</item>
        <item name="widgetThemeTitle">@string/widget_theme_dark</item>
        <item name="widgetThemeBackground">@drawable/widget_background_dark</item>
        <item name="widgetThemePalette">@array/widget_palette_dark</item>
    </style>
    <style name="WidgetTheme.LightHighContrast" parent="">
        <item name="widgetThemeKey">light-high-contrast</item>
        <item name="widgetThemeTitle">@string/widget_theme_light_high_contrast</item>
        <item name="widgetThemeBackground">@drawable/widget_background</item>
        <item name="widgetThemePalette">@array/widget_palette_light_high_contrast</item>
        <item name="widgetThemeBorder">@color/widget_border_light_high_contrast</item>
    </style>
    <style name="WidgetTheme.DarkHighContrast" parent="">
        <item name="widgetThemeKey">dark-high-contrast</item>
        <item name="widgetThemeTitle">@string/widget_theme_dark_high_contrast</item>
        <item name="widgetThemeBackground">@drawable/widget_background_dark_high_contrast</item>
        <item name="widgetThemePalette">@array/widget_palette_dark_high_contrast</item>
        <item name="widgetThemeBorder">@color/widget_border_dark_high_contrast</item>
    </style>
    <style name="WidgetTheme.DarkDimmed" parent="">
        <item name="widgetThemeKey">dark-dimmed</item>
        <item name="widgetThemeTitle">@string/widget_theme_dark_dimmed</item>
        <item name="widgetThemeBackground">@drawable/widget_background_dark_dimmed</item>
        <item name="widgetThemePalette">@array/widget_palette_dark_dimmed</item>
    </style>
    <style name="WidgetTheme.DarkDimmedHighContrast" parent="">
        <item name="widgetThemeKey">dark-dimmed-high-contrast</item>
        <item name="widgetThemeTitle">@string/widget_theme_dark_dimmed_high_contrast</item>
        <item name="widgetThemeBackground">@drawable/widget_background_dark_dimmed</item>
        <item name="widgetThemePalette">@array/widget_palette_dark_dimmed_high_contrast</item>
    </style>
    <style name="WidgetTheme.HalloweenLight" parent="">
        <item name="widgetThemeKey">halloween-light</item>
        <item name="widgetThemeTitle">@string/widget_theme_halloween_light</item>
        <item name="widgetThemeBackground">@drawable/widget_background</item>
        <item name="widgetThemePalette">@array/widget_palette_halloween_light</item>
    </style>
    <style name="WidgetTheme.HalloweenDark" parent="">
        <item name="widgetThemeKey">halloween-dark</item>
        <item name="widgetThemeTitle">@string/widget_theme_halloween_dark</item>
        <item name="widgetThemeBackground">@drawable/widget_background_dark</item>
        <item name="widgetThemePalette">@array/widget_palette_halloween_dark</item>
    </style>
    <style name="WidgetTheme.WinterLight" parent="">
        <item name="widgetThemeKey">winter-light</item>
        <item name="widgetThemeTitle">@string/widget_theme_winter_light</item>
        <item name="widgetThemeBackground">@drawable/widget_background</item>
        <item name="widgetThemePalette">@array/widget_palette_winter_light</item>
        <item name="widgetThemeAliases">@array/widget_theme_winter_light_aliases</item>
    </style>
    <style name="WidgetTheme.WinterDark" parent="">
        <item name="widgetThemeKey">winter-dark</item>
        <item name="widgetThemeTitle">@string/widget_theme_winter_dark</item>
        <item name="widgetThemeBackground">@drawable/widget_background_dark</item>
        <item name="widgetThemePalette">@array/widget_palette_winter_dark</item>
    </style>
    <style name="WidgetTheme.Transparent" parent="">
        <item name="widgetThemeKey">transparent</item>
        <item name="widgetThemeTitle">@string/widget_theme_transparent</item>
        <item name="widgetThemeBackground">@android:color/transparent</item>
        <item name="widgetThemePalette">@array/widget_palette_transparent</item>
    </style>
    <string-array name="widget_theme_winter_light_aliases" translatable="false">
        <item>blue</item>
    </string-array>

    <array name="widget_palette_light">
